{
  "type": "object",
  "required": ["scope_week", "topic", "evidence", "previous_week_narrative", "cross_week_diff", "key_decisions", "visible_outputs", "tagged_blockers"],
  "properties": {
    "scope_week": {"type": "string", "pattern": "^\\d{4}-W\\d{2}$"},
    "topic": {"type": "object"},
    "evidence": {"type": "array"},
    "previous_week_narrative": {"type": ["string", "null"]},
    "cross_week_diff": {"type": "array"},
    "key_decisions": {"type": "array"},
    "visible_outputs": {"type": "array"},
    "tagged_blockers": {"type": "array"},
    "canonical_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canonical_name": {"type": "string"},
          "type": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "appears_on_dates": {"type": "array", "items": {"type": "string"}},
          "merge_reasoning": {"type": "string"}
        }
      }
    },
    "event_entity_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {"type": "string"},
          "primary_entity": {"type": "string"},
          "confidence": {"type": "number"},
          "needs_review": {"type": "boolean"},
          "date": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
