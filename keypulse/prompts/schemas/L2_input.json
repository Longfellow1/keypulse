{
  "type": "object",
  "required": ["date", "clusters", "misc_events"],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["display_name", "topic_action", "events"],
        "additionalProperties": false,
        "properties": {
          "display_name": {"type": "string", "minLength": 1},
          "topic_action": {
            "type": "string",
            "enum": ["existing", "new"]
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["t", "s", "c"],
              "additionalProperties": false,
              "properties": {
                "t": {"type": "string"},
                "s": {"type": "string"},
                "a": {"type": "string"},
                "c": {"type": "string"},
                "sp": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "misc_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "s", "c"],
        "additionalProperties": false,
        "properties": {
          "t": {"type": "string"},
          "s": {"type": "string"},
          "a": {"type": "string"},
          "c": {"type": "string"},
          "sp": {"type": "string"}
        }
      }
    }
  }
}
