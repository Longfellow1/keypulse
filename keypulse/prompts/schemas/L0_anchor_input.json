{
  "type": "object",
  "required": ["date", "today_clusters", "weekly_anchors"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "today_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cluster_id", "display_name", "narrative_one_line", "event_count"],
        "properties": {
          "cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string"
          },
          "narrative_one_line": {
            "type": "string"
          },
          "event_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "weekly_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "display", "started", "last_active", "state", "daily_progress", "candidate_for_days"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,40}$"
          },
          "display": {
            "type": "string"
          },
          "started": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "last_active": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "state": {
            "type": "string",
            "enum": ["active", "candidate", "completed", "stale"]
          },
          "daily_progress": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "candidate_for_days": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
