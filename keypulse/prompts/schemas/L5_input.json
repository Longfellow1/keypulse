{
  "type": "object",
  "required": [
    "topics_to_write"
  ],
  "properties": {
    "topics_to_write": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "display_name",
          "status",
          "weekly_entries",
          "previous_week_narrative"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,40}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "accelerating",
              "steady",
              "declining",
              "revived",
              "ongoing"
            ]
          },
          "weekly_entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "date",
                "narrative_one_line"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "narrative_one_line": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "previous_week_narrative": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
