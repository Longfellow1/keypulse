{
  "type": "object",
  "required": [
    "clusters",
    "misc_event_ids"
  ],
  "properties": {
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "topic_action"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "topic_action": {
            "type": "string",
            "enum": [
              "existing",
              "new",
              "misc"
            ]
          },
          "topic_slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,40}$"
          },
          "merge_with_component": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "topic_action": {
                  "const": "existing"
                }
              }
            },
            "then": {
              "required": [
                "topic_slug"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "topic_action": {
                  "const": "new"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "misc_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
