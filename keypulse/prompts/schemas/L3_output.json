{
  "type": "object",
  "required": [
    "slug",
    "display_name",
    "keywords"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,40}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "keywords": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{2,30}$"
      }
    }
  },
  "additionalProperties": false
}
