{
  "type": "object",
  "required": ["date", "entities", "event_entity_map", "cross_entity_warning"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 日期"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "aliases", "confidence", "evidence_event_ids"],
        "properties": {
          "name": {
            "type": "string",
            "description": "实体名称"
          },
          "type": {
            "type": "string",
            "enum": ["project", "product", "tool", "feature", "system", "other"],
            "description": "实体类型"
          },
          "aliases": {
            "type": "array",
            "items": {"type": "string"},
            "description": "实体别名列表"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "识别置信度 (0.0-1.0)"
          },
          "evidence_event_ids": {
            "type": "array",
            "items": {"type": "string"},
            "description": "包含该实体的事件 ID 列表"
          }
        }
      },
      "description": "识别出的所有实体"
    },
    "event_entity_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "primary_entity", "secondary_entities", "confidence", "needs_review", "review_reason"],
        "properties": {
          "event_id": {
            "type": "string",
            "description": "事件 ID"
          },
          "primary_entity": {
            "type": "string",
            "description": "主要归属实体名称"
          },
          "secondary_entities": {
            "type": "array",
            "items": {"type": "string"},
            "description": "次要实体列表"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "归属置信度"
          },
          "needs_review": {
            "type": "boolean",
            "description": "是否需要人工审核"
          },
          "review_reason": {
            "type": "string",
            "description": "审核原因（如 needs_review=true 时填写）"
          }
        }
      },
      "description": "每条事件的实体映射"
    },
    "cross_entity_warning": {
      "type": "array",
      "items": {"type": "string"},
      "description": "识别过程中的警告或提示"
    }
  }
}
