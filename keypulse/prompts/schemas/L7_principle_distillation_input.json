{
  "type": "object",
  "required": ["date", "keyboard_chunks", "known_principles"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "keyboard_chunks": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "required": ["id", "ts_start", "app_name", "window_title", "content"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "ts_start": {"type": "string", "minLength": 1},
          "app_name": {"type": "string"},
          "window_title": {"type": "string"},
          "content": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "known_principles": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["principle_id"],
        "properties": {
          "principle_id": {"type": "string", "minLength": 1},
          "distilled": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
