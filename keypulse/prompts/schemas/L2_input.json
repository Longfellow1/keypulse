{
  "type": "object",
  "required": [
    "scope_date",
    "component_id",
    "event_ids",
    "events",
    "topic_context"
  ],
  "properties": {
    "scope_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "app",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "app": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "topic_context": {
      "type": "object",
      "required": [
        "topic_action"
      ],
      "properties": {
        "topic_action": {
          "type": "string",
          "enum": [
            "existing",
            "new",
            "misc"
          ]
        },
        "topic_slug": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
