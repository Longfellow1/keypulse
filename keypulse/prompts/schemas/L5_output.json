{
  "type": "object",
  "required": [
    "narratives"
  ],
  "properties": {
    "narratives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "narrative",
          "anchors"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,40}$"
          },
          "narrative": {
            "type": "string",
            "minLength": 30,
            "maxLength": 120
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\[\\[\\d{4}-\\d{2}-\\d{2}\\]\\]$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
