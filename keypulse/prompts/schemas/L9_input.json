{
  "type": "object",
  "required": ["date", "extractor_output", "events"],
  "properties": {
    "date": {
      "type": "string",
      "description": "ISO 8601 日期 (YYYY-MM-DD)"
    },
    "extractor_output": {
      "type": "object",
      "required": ["date", "entities", "event_entity_map", "cross_entity_warning"],
      "properties": {
        "date": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "aliases", "confidence", "evidence_event_ids"],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_event_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "event_entity_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_id", "primary_entity", "secondary_entities", "confidence"],
            "properties": {
              "event_id": {
                "type": "string"
              },
              "primary_entity": {
                "type": "string"
              },
              "secondary_entities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "needs_review": {
                "type": "boolean"
              },
              "review_reason": {
                "type": "string"
              }
            }
          }
        },
        "cross_entity_warning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "ts_start",
          "source",
          "speaker",
          "app_name",
          "window_title",
          "content_text",
          "work_unit",
          "file_paths",
          "urls"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "ts_start": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "app_name": {
            "type": "string"
          },
          "window_title": {
            "type": "string"
          },
          "content_text": {
            "type": "string"
          },
          "work_unit": {
            "type": "string"
          },
          "file_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
