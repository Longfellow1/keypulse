[importlinter]
include_external_packages = True
root_packages =
    penpal
    AppKit
    Foundation
    Quartz
    objc
    ApplicationServices
    CoreFoundation
    Vision
    WebKit

[importlinter:contract:macos-libs-only-in-platform-layers]
name = macOS-only libs (pyobjc) only in capture / hud / startup layers
type = forbidden
source_modules =
    penpal.store
    penpal.search
    penpal.sources
    penpal.mcp
    penpal.privacy
    penpal.services
    penpal.observability
    penpal.utils
    penpal.health
    penpal.config
    penpal.capabilities
forbidden_modules =
    AppKit
    Foundation
    Quartz
    objc
    ApplicationServices
    CoreFoundation
    Vision
    WebKit
allow_indirect_imports = True
ignore_imports =
    # These capability probes directly check macOS permissions and runtime availability.
    penpal.capabilities.builtin.accessibility_permission -> ApplicationServices
    penpal.capabilities.builtin.appkit_runtime -> AppKit
    penpal.capabilities.builtin.screen_recording_permission -> Quartz

[importlinter:contract:capture-below-capabilities]
name = capture must not import capabilities (capabilities -> capture is one-way; no cycle)
type = forbidden
source_modules =
    penpal.capture
forbidden_modules =
    penpal.capabilities

[importlinter:contract:hud-logic-without-appkit]
name = HUD view-model / controller / renderer stay AppKit-free (only hud.app is the shell)
type = forbidden
source_modules =
    penpal.hud.snapshot
    penpal.hud.viewmodel
    penpal.hud.controller
    penpal.hud.render
forbidden_modules =
    AppKit
    Foundation
    Quartz
    objc
    ApplicationServices
    CoreFoundation
    Vision
    WebKit
allow_indirect_imports = True

[importlinter:contract:runtime-evidence-boundary]
name = Only the runtime evaluator and daemon writer may read runtime evidence
type = forbidden
source_modules =
    penpal
forbidden_modules =
    penpal.foundation.runtime_record
    penpal.foundation.runtime_launchd
allow_indirect_imports = True
ignore_imports =
    # D36: runtime evaluator owns evidence reads; daemon manager is the sole evidence writer.
    penpal.runtime.evaluate -> penpal.foundation.runtime_record
    penpal.runtime.evaluate -> penpal.foundation.runtime_launchd
    penpal.runtime.control -> penpal.foundation.runtime_launchd
    penpal.capture.manager_runtime -> penpal.foundation.runtime_record
    penpal.capture.manager_runtime -> penpal.foundation.runtime_launchd

[importlinter:contract:layers]
name = Penpal module layers
type = layers
layers =
    penpal.feedback_cli : penpal.mcp.server : penpal.mcp.cli : penpal.hud : penpal.app : penpal.app_bundle : penpal.cli
    penpal.health : penpal.capabilities : penpal.services : penpal.runtime
    penpal.sources : penpal.capture : penpal.search : penpal.mcp.auth : penpal.mcp.audit : penpal.mcp.tools : penpal.privacy : penpal.permissions : penpal.observability
    penpal.store : penpal.config : penpal.i18n : penpal.foundation : penpal.utils
