{
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["slug", "kind", "distilled", "quote", "confidence"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "distilled": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "quote": {
            "type": "string",
            "minLength": 30,
            "maxLength": 200
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
