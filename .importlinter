[importlinter]
include_external_packages = True
root_packages =
    penpal
    AppKit
    Foundation
    Quartz
    objc
    ApplicationServices
    CoreFoundation
    Vision
    WebKit

[importlinter:contract:macos-libs-only-in-platform-layers]
name = macOS-only libs (pyobjc) only in capture / hud / startup layers
type = forbidden
source_modules =
    penpal.store
    penpal.search
    penpal.sources
    penpal.mcp
    penpal.privacy
    penpal.services
    penpal.observability
    penpal.utils
    penpal.health
    penpal.config
    penpal.capabilities
forbidden_modules =
    AppKit
    Foundation
    Quartz
    objc
    ApplicationServices
    CoreFoundation
    Vision
    WebKit
allow_indirect_imports = True
ignore_imports =
    penpal.capabilities.builtin.accessibility_permission -> ApplicationServices
    penpal.capabilities.builtin.appkit_runtime -> AppKit
    penpal.capabilities.builtin.screen_recording_permission -> Quartz

[importlinter:contract:capture-below-capabilities]
name = capture must not import capabilities (capabilities -> capture is one-way; no cycle)
type = forbidden
source_modules =
    penpal.capture
forbidden_modules =
    penpal.capabilities

[importlinter:contract:hud-logic-without-appkit]
name = HUD view-model / controller / renderer stay AppKit-free (only hud.app is the shell)
type = forbidden
source_modules =
    penpal.hud.snapshot
    penpal.hud.viewmodel
    penpal.hud.controller
    penpal.hud.render
forbidden_modules =
    AppKit
    Foundation
    Quartz
    objc
    ApplicationServices
    CoreFoundation
    Vision
    WebKit
allow_indirect_imports = True

[importlinter:contract:runtime-evidence-boundary]
name = Only the runtime evaluator and daemon writer may read runtime evidence
type = forbidden
source_modules =
    penpal
forbidden_modules =
    penpal.runtime.record
    penpal.runtime.launchd
allow_indirect_imports = True
ignore_imports =
    penpal.runtime.evaluate -> penpal.runtime.record
    penpal.runtime.evaluate -> penpal.runtime.launchd
    penpal.capture.manager -> penpal.runtime.record
    penpal.capture.manager_runtime -> penpal.runtime.record
    penpal.capture.manager_runtime -> penpal.runtime.launchd
