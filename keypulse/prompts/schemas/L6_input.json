{
  "type": "object",
  "required": [
    "scope_week",
    "weekly_dailies",
    "topic_status",
    "hud_inputs_this_week",
    "last_week_observation_text"
  ],
  "properties": {
    "scope_week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "weekly_dailies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "date",
          "content_full"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "content_full": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "topic_status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "display_name",
          "status",
          "weekly_count",
          "last_week_count"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,40}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "accelerating",
              "steady",
              "declining",
              "revived",
              "ongoing"
            ]
          },
          "weekly_count": {
            "type": "integer",
            "minimum": 0
          },
          "last_week_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "hud_inputs_this_week": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "content"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "last_week_observation_text": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
