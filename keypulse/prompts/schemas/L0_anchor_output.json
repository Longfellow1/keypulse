{
  "type": "object",
  "required": ["assignments", "new_anchors"],
  "properties": {
    "assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(unanchored|new_anchor:[a-z][a-z0-9-]{2,40}|[a-z][a-z0-9-]{2,40})$"
      }
    },
    "new_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "display", "started", "why"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,40}$"
          },
          "display": {
            "type": "string",
            "minLength": 1
          },
          "started": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
