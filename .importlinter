[importlinter]
include_external_packages = True
root_packages =
    penpal
    AppKit
    Foundation
    Quartz
    objc
    ApplicationServices
    CoreFoundation
    Vision
    WebKit

[importlinter:contract:macos-libs-only-in-platform-layers]
name = macOS-only libs (pyobjc) only in capture / hud / startup layers
type = forbidden
source_modules =
    penpal.store
    penpal.search
    penpal.sources
    penpal.mcp
    penpal.privacy
    penpal.services
    penpal.observability
    penpal.utils
    penpal.health
    penpal.config
    penpal.capabilities
forbidden_modules =
    AppKit
    Foundation
    Quartz
    objc
    ApplicationServices
    CoreFoundation
    Vision
    WebKit
allow_indirect_imports = True
ignore_imports =
    penpal.capabilities.builtin.accessibility_permission -> ApplicationServices
    penpal.capabilities.builtin.appkit_runtime -> AppKit
    penpal.capabilities.builtin.screen_recording_permission -> Quartz

[importlinter:contract:capture-below-capabilities]
name = capture must not import capabilities (capabilities -> capture is one-way; no cycle)
type = forbidden
source_modules =
    penpal.capture
forbidden_modules =
    penpal.capabilities
