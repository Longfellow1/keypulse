{
  "type": "object",
  "required": [
    "scope_date",
    "trigger",
    "components",
    "merge_candidates",
    "existing_topics_index"
  ],
  "properties": {
    "scope_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "18:00",
        "23:30"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "event_ids",
          "time_range"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "time_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            }
          },
          "h1_entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "h2_contexts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "size_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "peak_event_density": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "importance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "high_density_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "merge_candidates": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "existing_topics_index": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "display_name",
          "keywords",
          "last_seen"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,40}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_seen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "hot_cache": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hud_input_today": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
