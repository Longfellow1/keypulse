{
  "type": "object",
  "required": ["date", "events"],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "s", "c"],
        "additionalProperties": false,
        "properties": {
          "t": {"type": "string"},
          "s": {"type": "string"},
          "a": {"type": "string"},
          "c": {"type": "string"},
          "sp": {"type": "string"}
        }
      }
    }
  }
}
